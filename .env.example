# Contact form delivery.
# Gmail SMTP for the Google Workspace mailbox on strawsnberries.com.
# SMTP_PASS must be a Google App Password (16 characters), not the account password.
# Create one at: Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=info@strawsnberries.com
SMTP_PASS=

# Optional overrides. Defaults: smtp.gmail.com, port 465, send to info@strawsnberries.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# CONTACT_TO=info@strawsnberries.com
